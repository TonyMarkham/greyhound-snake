<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ue="UnityEditor.UIElements">
    <ui:VisualElement class="actuator-form">
        <ui:Label text="Step Actuator" class="section-title" />
        <ue:PropertyField binding-path="root" />
        <ue:PropertyField binding-path="target" />
        <ue:PropertyField binding-path="mj.type" />
        <ue:PropertyField binding-path="mj.group" />
        <ui:FloatField name="delay" binding-path="mj.delay" label="Delay" class="unity-base-field__aligned" />
        <ue:PropertyField binding-path="mj.ctrllimited" />
        <ui:FloatField name="ctrl-lo" binding-path="mj.ctrlLo" label="Ctrl Lo" class="unity-base-field__aligned" />
        <ui:FloatField name="ctrl-hi" binding-path="mj.ctrlHi" label="Ctrl Hi" class="unity-base-field__aligned" />
        <ue:PropertyField binding-path="mj.forcelimited" />
        <ui:FloatField name="force-lo" binding-path="mj.forceLo" label="Force Lo" class="unity-base-field__aligned" />
        <ui:FloatField name="force-hi" binding-path="mj.forceHi" label="Force Hi" class="unity-base-field__aligned" />
        <ui:FloatField name="lengthrange-lo" binding-path="mj.lengthrangeLo" label="Lengthrange Lo" class="unity-base-field__aligned" />
        <ui:FloatField name="lengthrange-hi" binding-path="mj.lengthrangeHi" label="Lengthrange Hi" class="unity-base-field__aligned" />
        <ue:PropertyField binding-path="mj.gear" />
        <ui:FloatField name="cranklength" binding-path="mj.cranklength" label="Cranklength" class="unity-base-field__aligned" />
        <ui:FloatField name="kp" binding-path="mj.kp" label="Kp" class="unity-base-field__aligned" />
        <ui:FloatField name="kv" binding-path="mj.kv" label="Kv" class="unity-base-field__aligned" />
        <ui:Label name="velocity-gain-warning" class="warning" text="kv is 0: a velocity servo with no gain produces no force" />
        <ui:FloatField name="dampratio" binding-path="mj.dampratio" label="Dampratio" class="unity-base-field__aligned" />
        <ui:Label name="exclusivity-warning" class="warning" text="kv and dampratio are exclusive; inheritrange is exclusive with an authored ctrlrange" />
        <ui:FloatField name="timeconst" binding-path="mj.timeconst" label="Timeconst" class="unity-base-field__aligned" />
        <ui:FloatField name="inheritrange" binding-path="mj.inheritrange" label="Inheritrange" class="unity-base-field__aligned" />
        <ui:FloatField name="damping" binding-path="mj.damping" label="Damping" class="unity-base-field__aligned" />
        <ui:FloatField name="armature" binding-path="mj.armature" label="Armature" class="unity-base-field__aligned" />
    </ui:VisualElement>
</ui:UXML>
