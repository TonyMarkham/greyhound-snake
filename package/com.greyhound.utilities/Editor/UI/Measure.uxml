<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ue="UnityEditor.UIElements">
    <ui:VisualElement class="measure-form">
        <ui:Label text="Measure" class="section-title" />
        <ue:ObjectField name="from" label="From" />
        <ue:ObjectField name="to" label="To" />
        <ui:Button name="measure-button" text="Measure" />
        <ui:Label text="Result: To - From, world, meters" class="list-header" />
        <ui:FloatField name="delta-x" label="Delta X" />
        <ui:FloatField name="delta-y" label="Delta Y" />
        <ui:FloatField name="delta-z" label="Delta Z" />
    </ui:VisualElement>
</ui:UXML>
