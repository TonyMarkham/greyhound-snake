.section-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 4px;
}

.warning {
    color: rgb(230, 110, 80);
    margin-top: 2px;
    margin-bottom: 6px;
    display: none;
}

.site-dropzone {
    border-width: 1px;
    border-radius: 3px;
    border-color: rgb(90, 90, 90);
    padding: 6px;
    margin-top: 4px;
    margin-bottom: 4px;
    opacity: 0.75;
    justify-content: center;
    -unity-text-align: middle-center;
}
