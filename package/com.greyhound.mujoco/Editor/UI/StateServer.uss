/* State Server inspector (StateServerEditor). Same card and section look
   as the element inspectors (Joint.uss, Root.uss). The bar colour is the
   server's own (blue grey), distinct from every element colour. */
.mujoco-card {
    border-width: 1px;
    border-left-width: 6px;
    border-color: rgb(90, 90, 90);
    border-radius: 4px;
    padding: 6px 8px 6px 8px;
    margin: 4px 0 6px 0;
}

.mujoco-card--server {
    border-left-color: rgb(96, 125, 139);
}

.mujoco-card__title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.mujoco-section {
    margin: 2px 0;
}

.mujoco-section > .unity-foldout__toggle {
    margin: 0;
    padding: 3px 4px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
}

.mujoco-section > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
}

.mujoco-section > .unity-foldout__content {
    margin-left: 4px;
    padding: 4px 0 4px 0;
}

/* One driven joint in Status (StateServerEditor.BuildRows): part, q, and
   Reset to Rest, set off from the next by a rule. */
.mujoco-driver-row {
    border-top-width: 1px;
    border-color: rgb(70, 70, 70);
    padding: 4px 0 4px 0;
}

.mujoco-subtitle {
    -unity-font-style: bold;
    margin: 6px 0 2px 3px;
}

.mujoco-hint {
    -unity-font-style: italic;
    opacity: 0.7;
    white-space: normal;
    margin: 2px 0 2px 3px;
}

.warning {
    color: rgb(230, 110, 80);
    margin-top: 2px;
    margin-bottom: 6px;
    white-space: normal;
}
