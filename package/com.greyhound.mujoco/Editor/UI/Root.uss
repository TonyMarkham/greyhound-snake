/* Root inspector (RootEditor). The model card uses the same card shape
   as the SiblingPath drawer; its bar is red with no model, green with
   one. Sections are foldouts with a darkened header band. */
.mujoco-card {
    border-width: 1px;
    border-left-width: 6px;
    border-color: rgb(90, 90, 90);
    border-radius: 4px;
    padding: 6px 8px 6px 8px;
    margin: 4px 0 6px 0;
}

.mujoco-card--empty {
    border-left-color: rgb(244, 67, 54);
}

.mujoco-card--set {
    border-left-color: rgb(76, 175, 80);
}

/* Element cards: the bar colour is the element type, not a state, so
   none of them uses the red/yellow/green state colours. The list's own
   foldout keeps its chevron inside the card: the inspector's negative
   left margin on foldout headers is zeroed here. */
.mujoco-card--element .unity-foldout__toggle {
    margin-left: 0;
}

.mujoco-card--joints {
    border-left-color: rgb(66, 133, 244);
}

.mujoco-card--actuators {
    border-left-color: rgb(255, 152, 0);
}

.mujoco-card--sites {
    border-left-color: rgb(156, 39, 176);
}

.mujoco-card--geoms {
    border-left-color: rgb(0, 150, 136);
}

.mujoco-card--sensors {
    border-left-color: rgb(233, 30, 99);
}

.mujoco-card__title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.mujoco-section {
    margin: 2px 0;
}

.mujoco-section > .unity-foldout__toggle {
    margin: 0;
    padding: 3px 4px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
}

.mujoco-section > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
}

.mujoco-section > .unity-foldout__content {
    margin-left: 4px;
    padding: 4px 0 4px 0;
}

.mujoco-subheader {
    -unity-font-style: italic;
    opacity: 0.7;
    margin: 4px 0 2px 3px;
}

.mujoco-export {
    margin-top: 8px;
    height: 24px;
}

.mujoco-add {
    margin-top: 4px;
    align-self: flex-start;
}
