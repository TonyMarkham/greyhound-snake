/* Sensor inspector (SensorEditor). Same card and section look as the Root
   inspector (Root.uss); the card bar is the Sensors colour used on the
   Root's element cards. */
.mujoco-card {
    border-width: 1px;
    border-left-width: 6px;
    border-color: rgb(90, 90, 90);
    border-radius: 4px;
    padding: 6px 8px 6px 8px;
    margin: 4px 0 6px 0;
}

.mujoco-card--sensors {
    border-left-color: rgb(233, 30, 99);
}

.mujoco-card__title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.mujoco-section {
    margin: 2px 0;
}

.mujoco-section > .unity-foldout__toggle {
    margin: 0;
    padding: 3px 4px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
}

.mujoco-section > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
}

.mujoco-section > .unity-foldout__content {
    margin-left: 4px;
    padding: 4px 0 4px 0;
}

.mujoco-hint {
    -unity-font-style: italic;
    opacity: 0.7;
    white-space: normal;
    margin: 2px 0 2px 3px;
}
